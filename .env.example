# Service Fusion API Credentials
# Generate at: My Office > Developer Settings > API Credentials
SF_CLIENT_ID=your_client_id_here
SF_CLIENT_SECRET=your_client_secret_here

# Optional overrides (defaults shown)
SF_API_BASE_URL=https://api.servicefusion.com/v1
SF_TOKEN_URL=https://api.servicefusion.com/oauth/access_token
